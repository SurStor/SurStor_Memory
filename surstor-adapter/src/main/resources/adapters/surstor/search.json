{
  "name": "Semantic search",
  "description": "Local embedding search over stored artifacts. Returns ranked artifact IDs with scores and snippets; resolve full content via surstor:retrieve.",
  "operation": {
    "adapter": "surstor:search",
    "input": {
      "type": "object",
      "properties": {
        "query":     { "type": "string", "description": "Natural language query" },
        "k":         { "type": "integer", "description": "Max results (default 10, max 100)" },
        "sessionId": { "type": "string", "description": "Optional session filter" }
      },
      "required": ["query"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "results": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "id":      { "type": "string" },
            "shortId": { "type": "string" },
            "score":   { "type": "number" },
            "snippet": { "type": "string" },
            "sessionId": { "type": "string" },
            "timestamp": { "type": "integer" }
          } } },
        "model": { "type": "string", "description": "Embedding model used" },
        "tookMs": { "type": "integer" }
      }
    }
  }
}
