<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.surstor</groupId>
        <artifactId>surstor-node-parent</artifactId>
        <version>0.2.0-alpha.2</version>
    </parent>

    <artifactId>surstor-node</artifactId>
    <name>SurStor Node CLI</name>
    <description>Packaging, config, identity bootstrap, and CLI for a single-user SurStor node</description>

    <dependencies>
        <dependency>
            <groupId>ai.surstor</groupId>
            <artifactId>surstor-adapter</artifactId>
            <version>${project.version}</version>
            <!-- DJL/Lucene/ONNX are bundled in the adapter's MODULE jar, which
                 the venue loads with a child-first classloader. They must NOT
                 also be on the node's own classpath: duplicate copies make
                 DJL's ServiceLoader discovery mix classloaders
                 (HfZooProvider "not a subtype"). The node's own code never
                 touches these APIs directly. -->
            <exclusions>
                <exclusion>
                    <groupId>ai.djl</groupId>
                    <artifactId>api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ai.djl.huggingface</groupId>
                    <artifactId>tokenizers</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ai.djl.onnxruntime</groupId>
                    <artifactId>onnxruntime-engine</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.microsoft.onnxruntime</groupId>
                    <artifactId>onnxruntime</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.lucene</groupId>
                    <artifactId>lucene-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ai.covia</groupId>
            <artifactId>covia-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.covia</groupId>
            <artifactId>venue</artifactId>
        </dependency>
        <dependency>
            <groupId>world.convex</groupId>
            <artifactId>convex-core</artifactId>
        </dependency>
        <dependency>
            <groupId>world.convex</groupId>
            <artifactId>convex-peer</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>ai.surstor.node.Main</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <finalName>surstor-node</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
